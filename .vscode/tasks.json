{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "process",
			"label": "Build Debug firmware",
			"command": "cmake",
			"args": ["--build", "--preset", "Debug"],
			"options": {"cwd": "${workspaceFolder}"},
			"problemMatcher": []
		},
		{
			"type": "shell",
			"label": "OpenOCD: flash",
			"command": "openocd",
			"options": {
				"cwd": "${command:cmake.getLaunchTargetDirectory}"
			},
			"args": [
				"-f",
				"../../openocd.cfg",
				"-c",
				"program ${command:cmake.getLaunchTargetFilename} verify reset exit"
			],
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"dependsOn": "CMake: build",
			"detail": "Download program into STM32"
		},
		{
			"type": "cmake",
			"label": "CMake: build",
			"command": "build",
			"targets": [
				"all"
			],
			"preset": "${command:cmake.activeBuildPresetName}",
			"group": "build",
			"problemMatcher": [],
			"detail": "CMake template build task"
		}
	]
}
