{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "OpenOCD: Debug",
            // English junction avoids Windows GDB/MI issues with Chinese paths.
            "cwd": "H:/robomaster/cboard-debug",
            "executable": "H:/robomaster/cboard-debug/build/Debug/text3.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "openocd",
            "serverpath": "D:/STM32DevTools/OpenOCD/xpack-openocd-0.12.0-7/bin/openocd.exe",
            "gdbPath": "D:/STM32DevTools/ArmGCC/xpack-arm-none-eabi-gcc-15.2.1-1.1/bin/arm-none-eabi-gdb.exe",
            "runToEntryPoint": "remote_task",
            "configFiles": [
                "openocd.cfg",
            ],
            "liveWatch": {
                "enabled": false,
                "samplesPerSecond": 20
            },
            "showDevDebugOutput": "raw",
            "preLaunchTask": "Build Debug firmware"
        }
    ]
}
